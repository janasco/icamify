# ---------------------------------------------------------------------------
# iCamify environment
#
# Copy to `.env` (never committed) or export these in your service manager.
# The config loader resolves `${VAR}` / `${VAR:-fallback}` inside
# config/icamify.json, so every secret below can stay out of the config file.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
ICAMIFY_CONFIG=./config/icamify.json
ICAMIFY_PORT=8060
ICAMIFY_LOG_LEVEL=info

# --- Auth ----------------------------------------------------------------
ICAMIFY_SESSION_SECRET=change-me-to-a-64-char-random-string

# --- Camera credentials --------------------------------------------------
FRONT_DOOR_USER=admin
FRONT_DOOR_PASS=
DRIVEWAY_USER=admin
DRIVEWAY_PASS=
LOBBY_PASS=
ONVIF_USER=admin
ONVIF_PASS=
WAREHOUSE_RTMP_KEY=

# --- WebRTC TURN ---------------------------------------------------------
TURN_CREDENTIAL=

# --- API token (SHA-256 of the bearer token) -----------------------------
HOMEASSISTANT_TOKEN_HASH=

# --- Local AI services ---------------------------------------------------
CODEPROJECT_AI_URL=http://127.0.0.1:32168
CODEPROJECT_AI_KEY=
DEEPSTACK_URL=http://127.0.0.1:5000
DEEPSTACK_KEY=
LPR_AGENT_URL=http://127.0.0.1:8080
LPR_AGENT_KEY=

# --- Alerting ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
MQTT_PASS=

# --- Archive target (optional) ------------------------------------------
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
